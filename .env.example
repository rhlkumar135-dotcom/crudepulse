# ═══ CrudePulse Environment Variables ═══════════════════════════════════════
# Copy this file to .env and fill in your values.
# All variables are optional — the app works without them using mock data.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# For Railway: use the auto-generated DATABASE_URL from your Postgres addon
# For local dev: file:./prisma/dev.db (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# ── API Keys (all optional — app falls back to mock data without them) ───────
# Get your key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=""

# Get your key at https://newsapi.org/register
NEWSAPI_KEY=""

# Get your key at https://www.eia.gov/opendata/register.php
EIA_API_KEY=""

# ── Hosting ───────────────────────────────────────────────────────────────────
# Set to your deployed URL for production
APP_URL="https://yourdomain.com"
